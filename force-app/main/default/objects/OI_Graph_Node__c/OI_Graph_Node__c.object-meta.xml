<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>OI Graph Node</label>
    <pluralLabel>OI Graph Nodes</pluralLabel>
    <nameField>
        <label>Graph Node Name</label>
        <type>AutoNumber</type>
        <displayFormat>NODE-{00000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <visibility>Public</visibility>
    <description>Canonical node version table backing the Graph Engine. One row per version, not one row per node (ADR-0014). Generic — carries no Salesforce-specific vocabulary (GraphEngine.md §1-2). Application-internal (ADR-0006).</description>
</CustomObject>
